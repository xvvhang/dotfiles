[user]
	name = xuhang
	email = xvvhang@icloud.com
[core]
	editor = nvim
	pager = delta
[init]
	defaultBranch = main
[color]
	ui = true
[interactive]
	diffFilter = delta --show-syntax-themes --dark
[delta]
  true-color = always
  navigate = true
  line-numbers = true
  side-by-side = true
[merge]
	conflictStyle = zdiff3
[push]
	default = current
[credential "https://github.com"]
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = !/usr/bin/gh auth git-credential
